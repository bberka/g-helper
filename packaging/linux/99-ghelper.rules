# G-Helper udev rules.
# Install as /etc/udev/rules.d/99-ghelper.rules (or /usr/lib/udev/rules.d/), then:
#   sudo udevadm control --reload && sudo udevadm trigger
#
# Access model
#   * the user logged in at the seat gets the devices through the "uaccess" tag (no group needed), and
#   * members of the "ghelper" group (sudo groupadd -r ghelper; sudo usermod -aG ghelper $USER) get them as well,
#     which also covers SSH / headless / autostart-before-login use.
# Everything that needs real root (debugfs raw access, ryzen_smu, msr, systemctl) goes through pkexec, see the polkit action.

# --- ASUS HID devices: Aura keyboards, AniMe Matrix, Slash, ROG Ally controller, mice, headsets, XG Mobile --------
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", TAG+="uaccess", GROUP="ghelper", MODE="0660"

# --- hotkeys: asus-wmi "Asus WMI hotkeys" and the ASUS USB keyboards (hid-asus), read only ------------------------
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Asus WMI hotkeys", TAG+="uaccess", GROUP="ghelper", MODE="0640"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{id/vendor}=="0b05", TAG+="uaccess", GROUP="ghelper", MODE="0640"

# --- key injection (virtual keyboard used for FN/M-key macros and media keys) -------------------------------------
KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", TAG+="uaccess", GROUP="ghelper", MODE="0660"

# --- asus-wmi / asus-armoury / platform_profile / battery / LEDs / fan curve attributes -----------------------------
# udev cannot chmod sysfs attributes declaratively, a helper does it for the "ghelper" group when the device appears.
ACTION=="add|change", SUBSYSTEM=="platform", KERNEL=="asus-nb-wmi|eeepc-wmi|asus-wmi", RUN+="/usr/lib/ghelper/ghelper-udev-perms platform %S%p"
ACTION=="add|change", SUBSYSTEM=="firmware-attributes", KERNEL=="asus-armoury", RUN+="/usr/lib/ghelper/ghelper-udev-perms armoury %S%p"
ACTION=="add|change", SUBSYSTEM=="platform-profile", RUN+="/usr/lib/ghelper/ghelper-udev-perms profile %S%p"
ACTION=="add|change", SUBSYSTEM=="power_supply", KERNEL=="BAT*", RUN+="/usr/lib/ghelper/ghelper-udev-perms battery %S%p"
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="asus::*|platform::micmute", RUN+="/usr/lib/ghelper/ghelper-udev-perms led %S%p"
ACTION=="add|change", SUBSYSTEM=="hwmon", ATTR{name}=="asus_custom_fan_curve", RUN+="/usr/lib/ghelper/ghelper-udev-perms fancurve %S%p"
ACTION=="add|change", SUBSYSTEM=="backlight", KERNEL=="asus_screenpad", RUN+="/usr/lib/ghelper/ghelper-udev-perms backlight %S%p"
