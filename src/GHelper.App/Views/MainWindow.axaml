<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="using:GHelper.App.Controls"
        xmlns:vm="using:GHelper.App.ViewModels"
        xmlns:t="using:GHelper.App.Theme"
        mc:Ignorable="d"
        x:Class="GHelper.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Title="{Binding WindowTitle}"
        Width="425"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="Manual"
        Icon="avares://GHelper/Assets/Tray/standard.png"
        d:DesignWidth="425" d:DesignHeight="760">

  <Design.DataContext>
    <x:Static Member="vm:DesignData.Main" />
  </Design.DataContext>

  <Window.Styles>
    <!-- 4 px gutters between the buttons / combo boxes of a row (legacy Margin 4 at 192 dpi); the row height is
         ControlHeight + gutters (UiMetrics.ControlRowHeight) so a button and a combo box are the same height. -->
    <Style Selector="UniformGrid > :is(c|RButton), UniformGrid > c|RComboBox">
      <Setter Property="Margin" Value="{x:Static t:UiMetrics.GridItemMargin}" />
    </Style>
    <!-- section blocks: 12 px between two sections -->
    <Style Selector="Border.section">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
  </Window.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="6" Spacing="0">

      <!-- ================= Performance mode ================= -->
      <Border Classes="section"
              AutomationProperties.Name="{Binding PerformanceAccessibleName}">
        <StackPanel Spacing="0">
          <Grid ColumnDefinitions="Auto,*,Auto" Height="20">
            <c:TintedImage Classes="sectionIcon" Source="avares://GHelper/Assets/Icons/icons8-gauge-32.png" />
            <TextBlock Grid.Column="1" Classes="title" Text="{Binding PerformanceTitle}" />
            <TextBlock Grid.Column="2" Classes="sensor" Name="CpuFanLabel" Text="{Binding CpuFanText}" />
          </Grid>
          <UniformGrid Columns="4" Height="{x:Static t:UiMetrics.ModeRowHeight}" Margin="0,6,0,0">
            <c:RButton Name="ButtonSilent" State="{Binding Silent}" IconOrientation="Vertical" IconSpacing="2"
                       Icon="avares://GHelper/Assets/Icons/icons8-bicycle-48.png" />
            <c:RButton Name="ButtonBalanced" State="{Binding Balanced}" IconOrientation="Vertical" IconSpacing="2"
                       Icon="avares://GHelper/Assets/Icons/icons8-fiat-500-48.png" />
            <c:RButton Name="ButtonTurbo" State="{Binding Turbo}" IconOrientation="Vertical" IconSpacing="2"
                       Icon="avares://GHelper/Assets/Icons/icons8-rocket-48.png" />
            <c:RButton Name="ButtonFans" State="{Binding Fans}" Secondary="True" IconOrientation="Vertical" IconSpacing="2"
                       Icon="avares://GHelper/Assets/Icons/icons8-fan-48.png" />
          </UniformGrid>
        </StackPanel>
      </Border>

      <!-- ================= GPU mode ================= -->
      <Border Classes="section" IsVisible="{Binding GpuSectionVisible}"
              AutomationProperties.Name="{Binding GpuAccessibleName}">
        <StackPanel Spacing="0">
          <Grid ColumnDefinitions="Auto,*,Auto" Height="20">
            <Panel>
              <c:TintedImage Classes="sectionIcon" IsVisible="{Binding !HasGpuError}"
                             Source="avares://GHelper/Assets/Icons/icons8-video-card-32.png" />
              <TextBlock Name="GpuErrorIcon" Text="&#x26A0;" Foreground="{DynamicResource CustomBrush}"
                         FontSize="16" Margin="4,0,6,0" Cursor="Hand" VerticalAlignment="Center"
                         IsVisible="{Binding HasGpuError}"
                         ToolTip.Tip="{Binding GpuError}" />
            </Panel>
            <TextBlock Grid.Column="1" Classes="title" Text="{Binding GpuTitle}" />
            <TextBlock Grid.Column="2" Classes="sensor" Name="GpuFanLabel" Text="{Binding GpuFanText}" />
          </Grid>

          <UniformGrid Name="GpuRow" Columns="{Binding GpuColumns}" Height="{x:Static t:UiMetrics.ModeRowHeight}" Margin="0,6,0,0"
                       IsVisible="{Binding GpuButtonsVisible}">
            <c:RButton Name="ButtonEco" State="{Binding Eco}" IconOrientation="Vertical" IconSpacing="2"
                       Icon="avares://GHelper/Assets/Icons/icons8-leaf-48.png" />
            <c:RButton Name="ButtonStandard" State="{Binding Standard}" IconOrientation="Vertical" IconSpacing="2"
                       Icon="avares://GHelper/Assets/Icons/icons8-spa-flower-48.png" />
            <c:RButton Name="ButtonXgm" State="{Binding Xgm}" IconOrientation="Vertical" IconSpacing="2"
                       Icon="avares://GHelper/Assets/Icons/icons8-video-48.png" />
            <c:RButton Name="ButtonStopGpu" State="{Binding StopGpu}" IconOrientation="Vertical" IconSpacing="2"
                       Icon="avares://GHelper/Assets/Icons/icons8-leaf-48.png" />
            <c:RButton Name="ButtonOptimized" State="{Binding Optimized}" IconOrientation="Vertical" IconSpacing="2"
                       Icon="avares://GHelper/Assets/Icons/icons8-project-management-48.png" />
            <c:RButton Name="ButtonUltimate" State="{Binding Ultimate}" IconOrientation="Vertical" IconSpacing="2"
                       Icon="avares://GHelper/Assets/Icons/icons8-game-controller-48.png" />
          </UniformGrid>

          <!-- ROG Ally: AutoTDP / Overlay / FPS limit -->
          <UniformGrid Columns="3" Height="{x:Static t:UiMetrics.LargeRowHeight}" Margin="0,6,0,0" IsVisible="{Binding GpuStripVisible}">
            <c:RButton State="{Binding AutoTdp}" IconSpacing="6"
                       Icon="avares://GHelper/Assets/Icons/icons8-gauge-32.png" />
            <c:RButton State="{Binding OverlayAlly}" IconSpacing="6"
                       Icon="avares://GHelper/Assets/Icons/icons8-heartbeat-32.png" />
            <c:RButton State="{Binding FpsLimit}" IconSpacing="6"
                       Icon="avares://GHelper/Assets/Icons/icons8-animation-32.png" />
          </UniformGrid>

          <TextBlock Classes="tip" Height="18" Margin="4,4,4,0" Text="{Binding GpuTip}" />
        </StackPanel>
      </Border>

      <!-- ================= Screen ================= -->
      <Border Classes="section" IsVisible="{Binding ScreenSectionVisible}"
              AutomationProperties.Name="{Binding ScreenAccessibleName}">
        <StackPanel Spacing="0">
          <Grid ColumnDefinitions="Auto,*,Auto" Height="20">
            <c:TintedImage Classes="sectionIcon" Source="avares://GHelper/Assets/Icons/icons8-laptop-32.png" />
            <TextBlock Grid.Column="1" Classes="title" Text="{Binding ScreenTitle}" />
            <TextBlock Grid.Column="2" Classes="sensor" Name="MidFanLabel" Text="{Binding MidFanText}" />
          </Grid>
          <UniformGrid Name="ScreenRow" Columns="{Binding ScreenColumns}" Height="{x:Static t:UiMetrics.LargeRowHeight}" Margin="0,6,0,0"
                       IsVisible="{Binding ScreenButtonsVisible}">
            <c:RButton Name="ButtonScreenAuto" State="{Binding ScreenAuto}" />
            <c:RButton Name="Button60Hz" State="{Binding Hz60}" />
            <c:RButton Name="Button120Hz" State="{Binding Hz120}" />
            <c:RButton Name="ButtonMiniLed" State="{Binding MiniLed}" />
            <c:RButton Name="ButtonFhd" State="{Binding Fhd}" />
            <c:RButton Name="ButtonHdrControl" State="{Binding HdrControl}" />
          </UniformGrid>
          <TextBlock Classes="tip" Height="18" Margin="4,4,4,0" Text="{Binding ScreenTip}" />
        </StackPanel>
      </Border>

      <!-- ================= Flicker-free dimming / visual modes ================= -->
      <Border Classes="section" IsVisible="{Binding GammaSectionVisible}">
        <StackPanel Spacing="0">
          <Grid ColumnDefinitions="Auto,*,Auto" Height="20">
            <c:TintedImage Classes="sectionIcon" Source="avares://GHelper/Assets/Icons/icons8-brightness-32.png" />
            <TextBlock Grid.Column="1" Classes="title" Text="{Binding GammaTitle}" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                       IsVisible="{Binding GammaSliderVisible}" Text="{Binding GammaText}" />
          </Grid>
          <c:RSlider Name="SliderGamma" Margin="0,5,0,0" Height="20" Minimum="0" Maximum="100" Step="5"
                     IsVisible="{Binding GammaSliderVisible}"
                     Value="{Binding Gamma, Mode=TwoWay}"
                     AutomationProperties.Name="{Binding GammaTitle}" />
          <UniformGrid Columns="3" Height="{x:Static t:UiMetrics.ControlRowHeight}" Margin="0,6,0,0" IsVisible="{Binding VisualTableVisible}">
            <c:RComboBox ItemsSource="{Binding VisualModes}" SelectedItem="{Binding SelectedVisualMode, Mode=TwoWay}"
                         IsVisible="{Binding VisualModeVisible}" />
            <c:RComboBox ItemsSource="{Binding ColorTemps}" SelectedItem="{Binding SelectedColorTemp, Mode=TwoWay}"
                         IsVisible="{Binding ColorTempVisible}" IsEnabled="{Binding VisualCombosEnabled}" />
            <c:RComboBox ItemsSource="{Binding Gamuts}" SelectedItem="{Binding SelectedGamut, Mode=TwoWay}"
                         IsVisible="{Binding GamutVisible}" IsEnabled="{Binding VisualCombosEnabled}" />
            <c:RButton State="{Binding InstallColors}" IconSpacing="6" Secondary="True"
                       Icon="avares://GHelper/Assets/Icons/icons8-color-32.png" />
          </UniformGrid>
          <TextBlock Name="VisualHintLabel" Classes="tip" Margin="4" Cursor="Hand"
                     IsVisible="{Binding VisualHintVisible}" Text="{Binding VisualHint}" />
        </StackPanel>
      </Border>

      <!-- ================= Anime Matrix / Slash ================= -->
      <Border Classes="section" IsVisible="{Binding MatrixSectionVisible}"
              AutomationProperties.Name="{Binding MatrixTitle}">
        <StackPanel Spacing="0">
          <Grid ColumnDefinitions="Auto,*" Height="20">
            <c:TintedImage Classes="sectionIcon" Source="avares://GHelper/Assets/Icons/icons8-matrix-32.png" />
            <TextBlock Grid.Column="1" Classes="title" Text="{Binding MatrixTitle}" />
          </Grid>
          <UniformGrid Columns="3" Height="{x:Static t:UiMetrics.ControlRowHeight}" Margin="0,6,0,0">
            <c:RComboBox ItemsSource="{Binding MatrixBrightnessItems}"
                         SelectedItem="{Binding SelectedMatrixBrightness, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding MatrixTitle}" />
            <c:RComboBox ItemsSource="{Binding MatrixRunningItems}"
                         SelectedItem="{Binding SelectedMatrixRunning, Mode=TwoWay}" />
            <c:RButton State="{Binding MatrixButton}" Secondary="True" />
          </UniformGrid>
        </StackPanel>
      </Border>

      <!-- ================= ROG Ally controller ================= -->
      <Border Classes="section" IsVisible="{Binding AllySectionVisible}"
              AutomationProperties.Name="{Binding AllyTitle}">
        <StackPanel Spacing="0">
          <Grid ColumnDefinitions="Auto,*" Height="20">
            <c:TintedImage Classes="sectionIcon" Source="avares://GHelper/Assets/Icons/icons8-controller-32.png" />
            <TextBlock Grid.Column="1" Classes="title" Text="{Binding AllyTitle}" />
          </Grid>
          <UniformGrid Columns="3" Height="{x:Static t:UiMetrics.LargeRowHeight}" Margin="0,6,0,0">
            <c:RButton State="{Binding AllyMode}" IconSpacing="6"
                       Icon="avares://GHelper/Assets/Icons/icons8-game-controller-48.png" />
            <c:RButton State="{Binding AllyBacklight}" IconSpacing="6"
                       Icon="avares://GHelper/Assets/Icons/backlight.png" />
            <c:RButton State="{Binding AllyController}" Secondary="True" IconSpacing="6"
                       Icon="avares://GHelper/Assets/Icons/icons8-controls-32.png" />
          </UniformGrid>
        </StackPanel>
      </Border>

      <!-- ================= Laptop keyboard ================= -->
      <Border Classes="section"
              AutomationProperties.Name="{Binding KeyboardTitle}">
        <StackPanel Spacing="0">
          <Grid ColumnDefinitions="Auto,*,*,*" Height="20" IsVisible="{Binding KeyboardHeaderVisible}">
            <c:TintedImage Classes="sectionIcon" Source="avares://GHelper/Assets/Icons/icons8-keyboard-32-alt.png" />
            <TextBlock Grid.Column="1" Classes="title" Text="{Binding KeyboardTitle}" />
            <Grid Grid.Column="3" ColumnDefinitions="*,*" Margin="0,0,2,0">
              <c:RButton Name="ButtonOverlay" State="{Binding Overlay}" Classes="flag" Secondary="True" Borderless="True"
                         Margin="0,0,2,0" />
              <c:RButton Name="ButtonFnLock" Grid.Column="1" State="{Binding FnLock}" Classes="flag" Secondary="True"
                         Borderless="True" Margin="2,0,0,0" />
            </Grid>
          </Grid>
          <UniformGrid Columns="3" Height="{x:Static t:UiMetrics.ControlRowHeight}" Margin="0,6,0,0">
            <c:RComboBox ItemsSource="{Binding AuraModes}" SelectedItem="{Binding SelectedAuraMode, Mode=TwoWay}"
                         IsVisible="{Binding AuraModeVisible}"
                         AutomationProperties.Name="{Binding AuraAccessibleName}" />
            <c:RColorButton Name="ButtonKeyboardColor" State="{Binding KeyboardColor}"
                            IsVisible="{Binding KeyboardColorVisible}"
                            SwatchColor="{Binding KeyboardSwatch}" SwatchColor2="{Binding KeyboardSwatch2}" />
            <c:RButton Name="ButtonKeyboardExtra" State="{Binding KeyboardExtra}" Secondary="True"
                       IconSpacing="6" Icon="avares://GHelper/Assets/Icons/icons8-settings-32.png" />
          </UniformGrid>
          <TextBlock Name="BacklightHintLabel" Margin="4,0" Height="17" Cursor="Hand"
                     Foreground="{DynamicResource StandardBrush}" Text="{Binding BacklightHint}" />
        </StackPanel>
      </Border>

      <!-- ================= Rear light ================= -->
      <Border Classes="section" IsVisible="{Binding RearSectionVisible}"
              AutomationProperties.Name="{Binding RearTitle}">
        <StackPanel Spacing="0">
          <Grid ColumnDefinitions="Auto,*" Height="20">
            <c:TintedImage Classes="sectionIcon"
                           Source="avares://GHelper/Assets/Icons/icons8-show-right-side-panel-48.png" />
            <TextBlock Grid.Column="1" Classes="title" Text="{Binding RearTitle}" />
          </Grid>
          <UniformGrid Columns="3" Height="{x:Static t:UiMetrics.ControlRowHeight}" Margin="0,6,0,0">
            <c:RComboBox ItemsSource="{Binding RearModes}" SelectedItem="{Binding SelectedRearMode, Mode=TwoWay}" />
            <c:RColorButton Name="ButtonRearColor" State="{Binding RearColor}"
                            SwatchColor="{Binding RearSwatch}" />
          </UniformGrid>
        </StackPanel>
      </Border>

      <!-- ================= Peripherals ================= -->
      <Border Classes="section" IsVisible="{Binding PeripheralsVisible}">
        <UniformGrid Columns="3" Height="60">
          <c:RButton Name="ButtonPeripheral1" State="{Binding Peripheral1}" Secondary="True" FontSize="11"
                     IconSpacing="6" Icon="avares://GHelper/Assets/Icons/icons8-maus-48.png" />
          <c:RButton Name="ButtonPeripheral2" State="{Binding Peripheral2}" Secondary="True" FontSize="11"
                     IconSpacing="6" Icon="avares://GHelper/Assets/Icons/icons8-maus-48.png" />
          <c:RButton Name="ButtonPeripheral3" State="{Binding Peripheral3}" Secondary="True" FontSize="11"
                     IconSpacing="6" Icon="avares://GHelper/Assets/Icons/icons8-maus-48.png" />
        </UniformGrid>
      </Border>

      <!-- ================= Battery charge limit ================= -->
      <Border Classes="section">
        <StackPanel Spacing="0">
          <Grid ColumnDefinitions="Auto,*,Auto" Height="22">
            <c:TintedImage Classes="sectionIcon" Source="avares://GHelper/Assets/Icons/icons8-charging-battery-32.png" />
            <TextBlock Grid.Column="1" Classes="title" Text="{Binding BatteryTitle}" />
            <TextBlock Grid.Column="2" Classes="sensor" Name="BatteryStatusLabel" Text="{Binding BatteryStatus}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" Height="22" Margin="0,2,0,0">
            <c:RSlider Name="SliderBattery" Minimum="40" Maximum="100" Step="5" Height="20"
                       Value="{Binding BatteryLimit, Mode=TwoWay}"
                       AutomationProperties.Name="{Binding BatteryAccessibleName}" />
            <c:RButton Name="ButtonBatteryFull" Grid.Column="1" State="{Binding BatteryFull}" Classes="flag"
                       Secondary="True" Borderless="True" Width="37" Margin="6,0,0,0" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- ================= Run on startup / charge ================= -->
      <Grid Margin="12,2,10,2" MinHeight="28" ColumnDefinitions="*,Auto">
        <c:RCheckBox IsChecked="{Binding RunOnStartup, Mode=TwoWay}" Content="{Binding RunOnStartupText}"
                     VerticalAlignment="Center" />
        <TextBlock Name="ChargeLabel" Grid.Column="1" Text="{Binding ChargeText}" Cursor="Hand"
                   Foreground="{DynamicResource ControlDarkBrush}" VerticalAlignment="Center" />
      </Grid>

      <!-- ================= Version / OEM software ================= -->
      <Grid Margin="10,2,12,2" MinHeight="{x:Static t:UiMetrics.FlagHeight}" ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Name="VersionLabel" Text="{Binding VersionText}" TextDecorations="Underline" Cursor="Hand"
                   Padding="5,0" VerticalAlignment="Center" Opacity="0.75"
                   Foreground="{DynamicResource ControlDarkBrush}">
          <TextBlock.Styles>
            <Style Selector="TextBlock.update">
              <Setter Property="Foreground" Value="{DynamicResource TurboBrush}" />
              <Setter Property="Opacity" Value="1" />
            </Style>
          </TextBlock.Styles>
        </TextBlock>
        <c:RButton Name="ButtonEnergySaver" Grid.Column="1" State="{Binding EnergySaver}" Classes="flag" Secondary="True"
                   Borderless="True" Width="82" Margin="4,0,0,0" />
        <c:RButton Name="ButtonAmdOled" Grid.Column="2" State="{Binding AmdOled}" Classes="flag" Secondary="True"
                   Borderless="True" Width="90" Margin="4,0,0,0" />
        <c:RButton Name="ButtonArmoury" Grid.Column="3" State="{Binding Armoury}" Classes="flag" Secondary="True"
                   Borderless="True" Width="90" Margin="4,0,0,0" />
      </Grid>

      <!-- ================= Footer ================= -->
      <Border Classes="section">
        <UniformGrid Columns="3" Height="{x:Static t:UiMetrics.ControlRowHeight}">
          <c:RBadgeButton Name="ButtonDonate" State="{Binding Donate}" Secondary="True"
                          Icon="avares://GHelper/Assets/Icons/icons8-heart-32.png" IconSpacing="6" />
          <c:RButton Name="ButtonUpdates" State="{Binding Updates}" Secondary="True"
                     Icon="avares://GHelper/Assets/Icons/icons8-software-32-white.png" IconSpacing="6" />
          <c:RButton Name="ButtonQuit" State="{Binding Quit}" Secondary="True"
                     Icon="avares://GHelper/Assets/Icons/icons8-quit-32.png" IconSpacing="6" />
        </UniformGrid>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Window>
