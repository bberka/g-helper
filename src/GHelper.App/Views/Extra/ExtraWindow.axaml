<views:SideWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:c="using:GHelper.App.Controls"
                 xmlns:views="using:GHelper.App.Views"
                 xmlns:e="using:GHelper.App.Views.Extra"
                 mc:Ignorable="d"
                 x:Class="GHelper.App.Views.Extra.ExtraWindow"
                 x:DataType="e:ExtraViewModel"
                 x:CompileBindings="True"
                 Title="{Binding WindowTitle}"
                 Width="506"
                 SizeToContent="Height"
                 Icon="avares://GHelper/Assets/Tray/standard.png"
                 d:DesignWidth="506" d:DesignHeight="700">

  <views:SideWindow.Styles>
    <Style Selector="c|TintedImage.sectionIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Margin" Value="4,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.sectionHeader">
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="5,4,5,2" />
    </Style>
    <Style Selector="Grid.sectionRow">
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="5,3,5,3" />
    </Style>
    <Style Selector="c|TintedImage.action">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="c|RCheckBox">
      <Setter Property="Padding" Value="6,0,0,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="24" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </views:SideWindow.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="8,6,8,8">

      <!-- key bindings -->
      <Grid Classes="sectionHeader" ColumnDefinitions="Auto,*,Auto,Auto">
        <c:TintedImage Classes="sectionIcon" Source="avares://GHelper/Assets/Icons/icons8-keyboard-32.png" />
        <TextBlock Grid.Column="1" Classes="title" Text="{Binding KeyBindingsCaption}" />
        <c:RButton Name="ButtonResetBindings" Grid.Column="2" Width="75" Height="22" Secondary="True"
                   Content="{Binding ResetCaption}" Command="{Binding ResetBindingsCommand}" />
        <c:TintedImage Name="PictureHelp" Grid.Column="3" Classes="action"
                       Source="avares://GHelper/Assets/Icons/icons8-help-32.png"
                       AutomationProperties.Name="Help" />
      </Grid>

      <ItemsControl Name="TableBindings" ItemsSource="{Binding KeyRows}" Margin="5,0,5,4"
                    AutomationProperties.Name="{Binding KeyBindingsCaption}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="e:KeyBindingRow">
            <Grid ColumnDefinitions="0.2*,0.4*,0.4*" IsVisible="{Binding IsVisible}" Margin="0,2">
              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="5,0,0,0" />
              <c:RComboBox Grid.Column="1" Margin="3,0" ItemsSource="{Binding Actions}"
                           SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                           AutomationProperties.Name="{Binding AccessibleName}" />
              <c:RTextBox Grid.Column="2" Margin="3,0" PlaceholderText="action" MinHeight="0" Height="24"
                          Padding="6,0" VerticalContentAlignment="Center"
                          Text="{Binding CustomText, Mode=TwoWay}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- laptop backlight -->
      <Grid Classes="sectionHeader" ColumnDefinitions="Auto,*,250" Margin="5,10,5,2">
        <c:TintedImage Classes="sectionIcon" Source="avares://GHelper/Assets/Icons/backlight.png" />
        <TextBlock Grid.Column="1" Classes="title" Text="{Binding BacklightCaption}" />
        <c:RSlider Name="SliderBrightness" Grid.Column="2" Minimum="0" Maximum="3" Step="1"
                   Value="{Binding Brightness, Mode=TwoWay}"
                   AutomationProperties.Name="{Binding BrightnessAccessibleName}" />
      </Grid>

      <ItemsControl Name="TableBacklight" ItemsSource="{Binding Zones}" Margin="5,0,5,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="e:BacklightZone">
            <Grid ColumnDefinitions="72,84,84,150,*" Height="26" IsVisible="{Binding IsVisible}">
              <TextBlock Classes="title" Text="{Binding Label}" Margin="6,0,0,0"
                         IsVisible="{Binding LabelVisible}" />
              <c:RCheckBox Grid.Column="1" Content="{Binding Awake.Text}" IsChecked="{Binding Awake.IsChecked, Mode=TwoWay}"
                           AutomationProperties.Name="{Binding Awake.AccessibleName}" />
              <c:RCheckBox Grid.Column="2" Content="{Binding Sleep.Text}" IsChecked="{Binding Sleep.IsChecked, Mode=TwoWay}"
                           AutomationProperties.Name="{Binding Sleep.AccessibleName}" />
              <c:RCheckBox Grid.Column="3" Content="{Binding Boot.Text}" IsChecked="{Binding Boot.IsChecked, Mode=TwoWay}"
                           AutomationProperties.Name="{Binding Boot.AccessibleName}" />
              <c:RCheckBox Grid.Column="4" Content="{Binding Battery.Text}" IsChecked="{Binding Battery.IsChecked, Mode=TwoWay}"
                           IsVisible="{Binding BatteryVisible}"
                           AutomationProperties.Name="{Binding Battery.AccessibleName}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <c:RCheckBox Name="CheckXgm" Margin="5,4,0,0" IsVisible="{Binding XgmVisible}"
                   Content="{Binding Xgm.Text}" IsChecked="{Binding Xgm.IsChecked, Mode=TwoWay}" />

      <Grid Classes="sectionRow" ColumnDefinitions="*,150" Margin="10,6,5,3">
        <TextBlock Text="{Binding SpeedCaption}" VerticalAlignment="Center" />
        <c:RComboBox Name="ComboKeyboardSpeed" Grid.Column="1" ItemsSource="{Binding Speeds}"
                     SelectedItem="{Binding SelectedSpeed, Mode=TwoWay}"
                     AutomationProperties.Name="{Binding SpeedAccessibleName}" />
      </Grid>

      <Grid Classes="sectionRow" ColumnDefinitions="*,Auto,Auto" Margin="10,3,5,3">
        <TextBlock Text="{Binding TimeoutCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <c:NumericUpDownWithUnit Name="NumericBacklightPluggedTime" Grid.Column="1" Width="100" ShowButtonSpinner="False" Margin="4,0"
                                 Minimum="0" Maximum="3600" Increment="1" Unit="sec"
                                 OffText="{Binding OffText}" FormatString="0"
                                 Value="{Binding BacklightPluggedTime, Mode=TwoWay}"
                                 AutomationProperties.Name="{Binding TimeoutPluggedName}" />
        <c:NumericUpDownWithUnit Name="NumericBacklightTime" Grid.Column="2" Width="100" ShowButtonSpinner="False"
                                 Minimum="0" Maximum="3600" Increment="1" Unit="sec"
                                 OffText="{Binding OffText}" FormatString="0"
                                 Value="{Binding BacklightTime, Mode=TwoWay}"
                                 AutomationProperties.Name="{Binding TimeoutBatteryName}" />
      </Grid>

      <!-- other settings -->
      <Grid Classes="sectionHeader" ColumnDefinitions="Auto,*,Auto,Auto" Margin="5,10,5,2">
        <c:TintedImage Classes="sectionIcon" Source="avares://GHelper/Assets/Icons/icons8-settings-32.png" />
        <TextBlock Grid.Column="1" Classes="title" Text="{Binding OtherCaption}" />
        <c:TintedImage Name="PictureScan" Grid.Column="2" Classes="action"
                       Source="avares://GHelper/Assets/Icons/icons8-search-32.png"
                       AutomationProperties.Name="Scan" />
        <c:TintedImage Name="PictureLog" Grid.Column="3" Classes="action"
                       Source="avares://GHelper/Assets/Icons/icons8-log-32.png"
                       AutomationProperties.Name="Log" />
      </Grid>

      <Grid Name="PanelAcpi" Classes="sectionRow" ColumnDefinitions="Auto,*,110,70,60" IsVisible="{Binding AcpiVisible}">
        <c:TintedImage Classes="sectionIcon" Source="avares://GHelper/Assets/Icons/icons8-heartbeat-32.png" />
        <TextBlock Grid.Column="1" Classes="title" Text="{Binding AcpiTitle}" />
        <c:RTextBox Grid.Column="2" PlaceholderText="Address" MinHeight="0" Height="24" Padding="6,0"
                    VerticalContentAlignment="Center" Text="{Binding AcpiCommand, Mode=TwoWay}" />
        <c:RTextBox Grid.Column="3" Margin="4,0" PlaceholderText="Value" MinHeight="0" Height="24" Padding="6,0"
                    VerticalContentAlignment="Center" Text="{Binding AcpiParam, Mode=TwoWay}" />
        <c:RButton Grid.Column="4" Content="Send" Command="{Binding AcpiSendCommand}" Secondary="True" Height="24" />
      </Grid>

      <Grid Name="PanelCores" Classes="sectionRow" ColumnDefinitions="Auto,*,100,100,60" IsVisible="{Binding CoresVisible}">
        <c:TintedImage Classes="sectionIcon" Source="avares://GHelper/Assets/Icons/icons8-processor-32.png" />
        <TextBlock Grid.Column="1" Classes="title" Text="{Binding CoresCaption}" TextTrimming="CharacterEllipsis" />
        <c:RComboBox Name="ComboCoresP" Grid.Column="2" Margin="2,0" ItemsSource="{Binding CoresPItems}"
                     SelectedIndex="{Binding CoresPIndex, Mode=TwoWay}" />
        <c:RComboBox Name="ComboCoresE" Grid.Column="3" Margin="2,0" ItemsSource="{Binding CoresEItems}"
                     SelectedIndex="{Binding CoresEIndex, Mode=TwoWay}" />
        <c:RButton Name="ButtonCores" Grid.Column="4" Margin="2,0,0,0" Content="{Binding ApplyCaption}"
                   Command="{Binding ApplyCoresCommand}" Secondary="True" Height="24" />
      </Grid>

      <Grid Name="PanelApu" Classes="sectionRow" ColumnDefinitions="Auto,*,150" IsVisible="{Binding ApuVisible}">
        <c:TintedImage Classes="sectionIcon" Source="avares://GHelper/Assets/Icons/icons8-video-48.png" />
        <TextBlock Grid.Column="1" Classes="title" Text="{Binding ApuCaption}" TextTrimming="CharacterEllipsis" />
        <c:RComboBox Name="ComboApu" Grid.Column="2" ItemsSource="{Binding ApuItems}"
                     SelectedIndex="{Binding ApuIndex, Mode=TwoWay}"
                     AutomationProperties.Name="{Binding ApuCaption}" />
      </Grid>

      <Grid Name="PanelOptimalBrightness" Classes="sectionRow" ColumnDefinitions="Auto,*,150"
            IsVisible="{Binding OptimalVisible}">
        <c:TintedImage Classes="sectionIcon" Source="avares://GHelper/Assets/Icons/icons8-brightness-32.png" />
        <TextBlock Grid.Column="1" Classes="title" Text="{Binding OptimalCaption}" TextTrimming="CharacterEllipsis" />
        <c:RComboBox Name="ComboOptimalBrightness" Grid.Column="2" ItemsSource="{Binding OptimalItems}"
                     SelectedIndex="{Binding OptimalIndex, Mode=TwoWay}"
                     AutomationProperties.Name="{Binding OptimalCaption}" />
      </Grid>

      <ItemsControl Name="PanelSettings" ItemsSource="{Binding SettingChecks}" Margin="10,4,5,4"
                    AutomationProperties.Name="{Binding WindowTitle}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="e:CheckItem">
            <c:RCheckBox Content="{Binding Text}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                         IsVisible="{Binding IsVisible}" ToolTip.Tip="{Binding ToolTip}"
                         AutomationProperties.Name="{Binding AccessibleName}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid Name="PanelPower" Classes="sectionRow" ColumnDefinitions="Auto,*,120" IsVisible="{Binding HibernateVisible}">
        <c:TintedImage Classes="sectionIcon" Source="avares://GHelper/Assets/Icons/icons8-hibernate-32.png" />
        <TextBlock Grid.Column="1" Text="{Binding HibernateCaption}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <c:NumericUpDownWithUnit Name="NumericHibernateAfter" Grid.Column="2" ShowButtonSpinner="False" Minimum="0" Maximum="3000000"
                                 Increment="10" Unit="min" OffText="{Binding OffText}" FormatString="0"
                                 Value="{Binding HibernateAfter, Mode=TwoWay}"
                                 AutomationProperties.Name="{Binding HibernateCaption}" />
      </Grid>

      <!-- Asus services -->
      <Grid Name="PanelServices" Classes="sectionRow" ColumnDefinitions="Auto,*,128" Margin="5,8,5,0"
            AutomationProperties.Name="{Binding ServicesText}">
        <c:TintedImage Classes="sectionIcon" Source="avares://GHelper/Assets/Icons/icons8-automation-32.png" />
        <TextBlock Name="LabelServices" Grid.Column="1" Classes="title" Text="{Binding ServicesText}"
                   Foreground="{Binding ServicesBrush}" />
        <c:RButton Name="ButtonServices" Grid.Column="2" Height="26" Secondary="True"
                   Content="{Binding ServicesButtonText}" IsEnabled="{Binding ServicesButtonEnabled}"
                   Command="{Binding ServicesCommand}" />
      </Grid>

    </StackPanel>
  </ScrollViewer>
</views:SideWindow>
