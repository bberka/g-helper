<p:PeripheralWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:GHelper.App.Controls"
        xmlns:p="using:GHelper.App.Views.Peripherals"
        xmlns:m="using:GHelper.App.Views.Mouse"
        x:Class="GHelper.App.Views.Mouse.MouseWindow"
        x:DataType="m:MouseViewModel"
        x:CompileBindings="True"
        Icon="avares://GHelper/Assets/Tray/standard.png">

  <Window.Styles>
    <StyleInclude Source="avares://GHelper/Views/Peripherals/PeripheralStyles.axaml" />
  </Window.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid ColumnDefinitions="Auto,Auto">

      <!-- ===================== key bindings (left) ===================== -->
      <StackPanel Name="BindingsPanel" Grid.Column="0" Width="272" Margin="14,10,0,14"
                  IsVisible="{Binding BindingsVisible}">
        <Grid Classes="header" ColumnDefinitions="Auto,*">
          <c:TintedImage Classes="headerIcon"
                         Source="avares://GHelper/Assets/Icons/icons8-natural-user-interface-48.png" />
          <TextBlock Grid.Column="1" Classes="title" Text="{Binding Texts.KeyBindings}" />
        </Grid>

        <UniformGrid Columns="2" Height="34" Margin="0,4" IsVisible="{Binding HasSpeedShift}">
          <c:RButton Classes="small" Content="{Binding Texts.Buttons}" Command="{Binding NormalLayerCommand}"
                     Activated="{Binding NormalLayerActivated}" Secondary="{Binding ShiftLayerActivated}"
                     BorderColor="#FF3AAEEF" />
          <c:RButton Classes="small" Content="{Binding Texts.SpeedShift}" Command="{Binding ShiftLayerCommand}"
                     Activated="{Binding ShiftLayerActivated}" Secondary="{Binding NormalLayerActivated}"
                     BorderColor="#FF3AAEEF" />
        </UniformGrid>

        <c:TintedImage Source="avares://GHelper/Assets/Icons/mouse-layout.png" Width="76" Height="148"
                       Margin="0,6,0,10" HorizontalAlignment="Center" />

        <ItemsControl ItemsSource="{Binding BindingRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:ButtonBindingRow">
              <Grid Classes="row" ColumnDefinitions="110,*">
                <TextBlock Classes="row" Text="{Binding Name}" />
                <p:BindingComboBox Grid.Column="1" ItemsSource="{Binding Entries}"
                                   SelectedItem="{Binding Selected, Mode=TwoWay}"
                                   IsEnabled="{Binding IsEnabled}"
                                   AutomationProperties.Name="{Binding Name}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <c:RButton Classes="small" Height="32" Margin="0,10,0,0" Content="{Binding Texts.Reset}"
                   Command="{Binding ResetBindingsCommand}" />
      </StackPanel>

      <!-- ===================== settings (right) ===================== -->
      <StackPanel Grid.Column="1" Width="470" Margin="14,10,14,14">

        <!-- battery + profile -->
        <Grid ColumnDefinitions="*,*" MinHeight="34">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      IsVisible="{Binding BatteryVisible}">
            <c:TintedImage Width="20" Height="20" IsVisible="{Binding BatteryNotCharging}"
                           Source="avares://GHelper/Assets/Icons/icons8-batterie-voll-geladen-48.png" />
            <c:TintedImage Width="20" Height="20" IsVisible="{Binding BatteryCharging}"
                           Source="avares://GHelper/Assets/Icons/icons8-ladende-batterie-48.png" />
            <TextBlock Classes="row" Text="{Binding BatteryText}" />
            <TextBlock Classes="row" Text="{Binding ChargingText}" IsVisible="{Binding BatteryCharging}" />
          </StackPanel>
          <Grid Grid.Column="1" ColumnDefinitions="Auto,*" IsVisible="{Binding ProfilesVisible}">
            <TextBlock Classes="row" Text="{Binding Texts.Profile}" Margin="0,0,10,0" />
            <c:RComboBox Grid.Column="1" ItemsSource="{Binding ProfileItems}"
                         SelectedIndex="{Binding SelectedProfile, Mode=TwoWay}"
                         VerticalAlignment="Center" />
          </Grid>
        </Grid>

        <!-- ===== performance ===== -->
        <StackPanel IsVisible="{Binding PerformanceVisible}">
          <Grid Classes="header" ColumnDefinitions="Auto,*">
            <c:TintedImage Classes="headerIcon" Source="avares://GHelper/Assets/Icons/icons8-mauszeiger-50.png" />
            <TextBlock Grid.Column="1" Classes="title" Text="{Binding Texts.Performance}" />
          </Grid>

          <!-- DPI profiles -->
          <ItemsControl Name="DpiSlotsList" ItemsSource="{Binding DpiSlots}" Height="64"
                        IsEnabled="{Binding NormalControlsEnabled}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" Columns="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="m:DpiSlot">
                <m:DpiSlotButton Margin="2" IsVisible="{Binding IsVisible}"
                                 Command="{Binding Command}" DeleteCommand="{Binding DeleteCommand}"
                                 CanDelete="{Binding CanDelete}" Activated="{Binding Activated}"
                                 BorderColor="{Binding BorderColor}" Secondary="{Binding Secondary}">
                  <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Fill="{Binding DotBrush}" IsVisible="{Binding HasDot}" />
                    <TextBlock Text="{Binding Text}" TextAlignment="Center" FontWeight="Normal" />
                  </StackPanel>
                </m:DpiSlotButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- DPI of the selected profile -->
          <Grid ColumnDefinitions="*,Auto" Height="36" Margin="0,6,0,0" IsVisible="{Binding DpiColorVisible}"
                IsEnabled="{Binding NormalControlsEnabled}">
            <TextBlock Classes="row" Text="{Binding Texts.Dpi}" />
            <c:RColorButton Name="DpiColorButton" Grid.Column="1" Width="130" Height="28"
                            Content="{Binding Texts.Color}" SwatchColor="{Binding DpiColor}"
                            AutomationProperties.Name="DPI color" />
          </Grid>
          <Grid ColumnDefinitions="38*,24*,38*" Height="34" IsEnabled="{Binding NormalControlsEnabled}">
            <TextBlock Classes="row" Text="{Binding DpiMinText}" />
            <c:RNumericUpDown Name="DpiNumeric" Grid.Column="1" ShowButtonSpinner="True"
                              Minimum="{Binding DpiMin}" Maximum="{Binding DpiMax}"
                              Increment="{Binding DpiStep}" FormatString="0"
                              Value="{Binding Dpi, Mode=OneWay}"
                              AutomationProperties.Name="DPI" />
            <TextBlock Grid.Column="2" Classes="row value" Text="{Binding DpiMaxText}" />
          </Grid>
          <c:RSlider Name="DpiSlider" Exponential="True" Margin="0,2,0,6"
                     Minimum="{Binding DpiMin}" Maximum="{Binding DpiMax}" Step="{Binding DpiStep}"
                     Value="{Binding Dpi, Mode=OneWay}"
                     IsEnabled="{Binding NormalControlsEnabled}"
                     AutomationProperties.Name="DPI" />

          <!-- polling rate -->
          <Grid Classes="row" ColumnDefinitions="*,190" IsVisible="{Binding PollingRateVisible}"
                IsEnabled="{Binding NormalControlsEnabled}">
            <TextBlock Classes="row" Text="{Binding Texts.PollingRate}" />
            <c:RComboBox Grid.Column="1" ItemsSource="{Binding PollingRateItems}"
                         SelectedIndex="{Binding PollingRateIndex, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding Texts.PollingRate}" />
          </Grid>

          <!-- angle snapping -->
          <Grid Classes="row" ColumnDefinitions="*,150,44" IsVisible="{Binding AngleSnappingPanelVisible}">
            <c:RCheckBox Content="{Binding Texts.AngleSnapping}" IsChecked="{Binding AngleSnapping, Mode=TwoWay}"
                         IsVisible="{Binding AngleSnappingVisible}" VerticalAlignment="Center" />
            <c:RSlider Name="AngleSlider" Grid.Column="1" IsVisible="{Binding AngleTuningVisible}"
                       Minimum="{Binding AngleMin}" Maximum="{Binding AngleMax}" Step="{Binding AngleStep}"
                       Value="{Binding AngleAdjustment, Mode=OneWay}"
                       AutomationProperties.Name="{Binding Texts.AngleSnapping}" />
            <TextBlock Grid.Column="2" Classes="row value" Text="{Binding AngleAdjustmentText}"
                       IsVisible="{Binding AngleTuningVisible}" />
          </Grid>

          <!-- motion sync -->
          <Grid Classes="row" ColumnDefinitions="*" IsVisible="{Binding MotionSyncVisible}">
            <c:RCheckBox Content="{Binding Texts.MotionSync}" IsChecked="{Binding MotionSync, Mode=TwoWay}"
                         IsEnabled="{Binding MotionSyncEnabled}" VerticalAlignment="Center" />
          </Grid>

          <!-- zone mode -->
          <StackPanel IsVisible="{Binding ZoneModeVisible}">
            <Grid Classes="row" ColumnDefinitions="*,110,140">
              <c:RCheckBox Content="{Binding Texts.ZoneMode}" IsChecked="{Binding ZoneMode, Mode=TwoWay}"
                           VerticalAlignment="Center" />
              <c:RComboBox Grid.Column="1" ItemsSource="{Binding ZoneModePollingRateItems}"
                           SelectedIndex="{Binding ZoneModePollingRateIndex, Mode=TwoWay}"
                           IsEnabled="{Binding ZoneModeControlsEnabled}" />
              <c:RNumericUpDown Name="ZoneDpiNumeric" Grid.Column="2" Margin="6,0,0,0" FormatString="0"
                                Minimum="{Binding DpiMin}" Maximum="{Binding DpiMax}" Increment="{Binding DpiStep}"
                                Value="{Binding ZoneModeDpi, Mode=OneWay}"
                                IsEnabled="{Binding ZoneModeControlsEnabled}" />
            </Grid>
            <c:RSlider Name="ZoneDpiSlider" Margin="0,0,0,4"
                       Minimum="{Binding DpiMin}" Maximum="{Binding DpiMax}" Step="{Binding DpiStep}"
                       Value="{Binding ZoneModeDpi, Mode=OneWay}"
                       IsEnabled="{Binding ZoneModeControlsEnabled}" />
          </StackPanel>

          <!-- button response (debounce) -->
          <Grid Classes="row" ColumnDefinitions="*,150,50" IsVisible="{Binding DebounceVisible}">
            <TextBlock Classes="row" Text="{Binding Texts.ButtonDebounce}" />
            <c:RSlider Name="DebounceSlider" Grid.Column="1"
                       Minimum="{Binding DebounceMin}" Maximum="{Binding DebounceMax}" Step="1"
                       Value="{Binding ButtonDebounce, Mode=OneWay}"
                       AutomationProperties.Name="{Binding Texts.ButtonDebounce}" />
            <TextBlock Grid.Column="2" Classes="row value" Text="{Binding ButtonDebounceText}" />
          </Grid>

          <!-- lift-off distance -->
          <Grid Classes="row" ColumnDefinitions="*,190" IsVisible="{Binding LiftOffVisible}">
            <TextBlock Classes="row" Text="{Binding Texts.LiftOffDistance}" />
            <c:RComboBox Grid.Column="1" ItemsSource="{Binding LiftOffItems}"
                         SelectedIndex="{Binding LiftOffIndex, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding Texts.LiftOffDistance}" />
          </Grid>

          <!-- acceleration / deceleration -->
          <Grid Classes="row" ColumnDefinitions="*,150,50" IsVisible="{Binding AccelerationVisible}">
            <TextBlock Classes="row" Text="{Binding Texts.Acceleration}" />
            <c:RSlider Name="AccelerationSlider" Grid.Column="1" Minimum="0" Maximum="{Binding AccelerationMax}" Step="1"
                       Value="{Binding Acceleration, Mode=OneWay}"
                       AutomationProperties.Name="{Binding Texts.Acceleration}" />
            <TextBlock Grid.Column="2" Classes="row value" Text="{Binding AccelerationText}" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="*,150,50" IsVisible="{Binding DecelerationVisible}">
            <TextBlock Classes="row" Text="{Binding Texts.Deceleration}" />
            <c:RSlider Name="DecelerationSlider" Grid.Column="1" Minimum="0" Maximum="{Binding DecelerationMax}" Step="1"
                       Value="{Binding Deceleration, Mode=OneWay}"
                       AutomationProperties.Name="{Binding Texts.Deceleration}" />
            <TextBlock Grid.Column="2" Classes="row value" Text="{Binding DecelerationText}" />
          </Grid>
        </StackPanel>

        <!-- ===== lighting ===== -->
        <StackPanel IsVisible="{Binding LightingVisible}">
          <Grid Classes="header" ColumnDefinitions="Auto,*,190">
            <c:TintedImage Classes="headerIcon" Source="avares://GHelper/Assets/Icons/backlight.png" />
            <TextBlock Grid.Column="1" Classes="title" Text="{Binding Texts.Lighting}" />
            <c:RSlider Name="BrightnessSlider" Grid.Column="2" Minimum="0" Maximum="{Binding BrightnessMax}" Step="1"
                       Value="{Binding Brightness, Mode=OneWay}"
                       AutomationProperties.Name="{Binding Texts.Lighting}" />
          </Grid>

          <UniformGrid Rows="1" Height="40" Margin="0,2,0,6" IsVisible="{Binding ZonesVisible}">
            <c:RButton Name="ZoneAllButton" Margin="2" Content="{Binding Texts.ZoneAll}" Command="{Binding ZoneAllCommand}"
                       Activated="{Binding ZoneAllActivated}" Secondary="{Binding ZoneAllSecondary}" />
            <c:RButton Name="ZoneLogoButton" Margin="2" Content="{Binding Texts.ZoneLogo}" IsVisible="{Binding ZoneLogoVisible}"
                       Command="{Binding ZoneLogoCommand}" Activated="{Binding ZoneLogoActivated}"
                       Secondary="{Binding ZoneIndividualSecondary}" />
            <c:RButton Name="ZoneScrollButton" Margin="2" Content="{Binding Texts.ZoneScroll}" IsVisible="{Binding ZoneScrollVisible}"
                       Command="{Binding ZoneScrollCommand}" Activated="{Binding ZoneScrollActivated}"
                       Secondary="{Binding ZoneIndividualSecondary}" />
            <c:RButton Name="ZoneUnderglowButton" Margin="2" Content="{Binding Texts.ZoneUnderglow}" IsVisible="{Binding ZoneUnderglowVisible}"
                       Command="{Binding ZoneUnderglowCommand}" Activated="{Binding ZoneUnderglowActivated}"
                       Secondary="{Binding ZoneIndividualSecondary}" />
            <c:RButton Name="ZoneDockButton" Margin="2" Content="{Binding Texts.ZoneDock}" IsVisible="{Binding ZoneDockVisible}"
                       Command="{Binding ZoneDockCommand}" Activated="{Binding ZoneDockActivated}"
                       Secondary="{Binding ZoneIndividualSecondary}" />
          </UniformGrid>

          <Grid Classes="row" ColumnDefinitions="*,190" IsEnabled="{Binding LightingControlsEnabled}">
            <TextBlock Classes="row" Text="{Binding Texts.LightingMode}" />
            <c:RComboBox Grid.Column="1" ItemsSource="{Binding LightingModeItems}"
                         SelectedIndex="{Binding SelectedLightingModeIndex, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding Texts.LightingMode}" />
          </Grid>

          <Grid Classes="row" ColumnDefinitions="*,190" IsEnabled="{Binding LightingControlsEnabled}"
                IsVisible="{Binding ColorRowVisible}">
            <Grid Grid.Column="1" ColumnDefinitions="100,*">
              <c:RColorButton Name="LightingColorButton" Height="28" Margin="0,0,8,0"
                              IsVisible="{Binding ColorVisible}"
                              Content="{Binding Texts.Color}" SwatchColor="{Binding LightingColor}"
                              AutomationProperties.Name="{Binding Texts.Color}" />
              <c:RCheckBox Grid.Column="1" Content="{Binding Texts.RandomColor}"
                           IsChecked="{Binding RandomColor, Mode=TwoWay}"
                           IsVisible="{Binding RandomColorVisible}" VerticalAlignment="Center" />
            </Grid>
          </Grid>

          <Grid Classes="row" ColumnDefinitions="*" Margin="0,2">
            <c:RCheckBox Content="{Binding Texts.SyncAura}" IsChecked="{Binding SyncAura, Mode=TwoWay}"
                         VerticalAlignment="Center" />
          </Grid>

          <Grid Classes="row" ColumnDefinitions="*,190" IsEnabled="{Binding LightingControlsEnabled}"
                IsVisible="{Binding AnimationSpeedVisible}">
            <TextBlock Classes="row" Text="{Binding Texts.AnimationSpeed}" />
            <c:RComboBox Grid.Column="1" ItemsSource="{Binding AnimationSpeedItems}"
                         SelectedIndex="{Binding AnimationSpeedIndex, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding Texts.AnimationSpeed}" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="*,190" IsEnabled="{Binding LightingControlsEnabled}"
                IsVisible="{Binding AnimationDirectionVisible}">
            <TextBlock Classes="row" Text="{Binding Texts.AnimationDirection}" />
            <c:RComboBox Grid.Column="1" ItemsSource="{Binding AnimationDirectionItems}"
                         SelectedIndex="{Binding AnimationDirectionIndex, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding Texts.AnimationDirection}" />
          </Grid>
        </StackPanel>

        <!-- ===== energy ===== -->
        <StackPanel IsVisible="{Binding EnergyVisible}">
          <Grid Classes="header" ColumnDefinitions="Auto,*">
            <c:TintedImage Classes="headerIcon"
                           Source="avares://GHelper/Assets/Icons/icons8-charging-battery-32.png" />
            <TextBlock Grid.Column="1" Classes="title" Text="{Binding Texts.Energy}" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="*,190" IsVisible="{Binding AutoPowerOffVisible}">
            <TextBlock Classes="row" Text="{Binding Texts.AutoPowerOff}" />
            <c:RComboBox Grid.Column="1" ItemsSource="{Binding AutoPowerOffItems}"
                         SelectedIndex="{Binding AutoPowerOffIndex, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding Texts.AutoPowerOff}" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="*,150,50" IsVisible="{Binding LowBatteryWarningVisible}">
            <TextBlock Classes="row" Text="{Binding Texts.LowBatteryWarning}" />
            <c:RSlider Name="LowBatterySlider" Grid.Column="1" Minimum="0" Maximum="{Binding LowBatteryWarningMax}"
                       Step="{Binding LowBatteryWarningStep}"
                       Value="{Binding LowBatteryWarning, Mode=OneWay}"
                       AutomationProperties.Name="{Binding Texts.LowBatteryWarning}" />
            <TextBlock Grid.Column="2" Classes="row value" Text="{Binding LowBatteryWarningText}" />
          </Grid>
        </StackPanel>

        <!-- ===== import / export / sync ===== -->
        <UniformGrid Name="BottomButtons" Rows="1" Height="40" Margin="0,14,0,0"
                     IsVisible="{Binding BottomButtonsVisible}">
          <c:RButton Name="SyncButton" Margin="2" Content="{Binding Texts.Synchronize}"
                     Command="{Binding SyncCommand}" />
          <c:RButton Name="ImportButton" Margin="2" Content="{Binding Texts.Import}" />
          <c:RButton Name="ExportButton" Margin="2" Content="{Binding Texts.Export}" />
        </UniformGrid>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</p:PeripheralWindow>
