<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>GHelper.App</RootNamespace>
    <AssemblyName>GHelper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <!-- must stay true: System.Management (WMI) and the task scheduler wrapper are COM based -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64;linux-x64;linux-arm64;linux-arm;linux-musl-x64;linux-musl-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <InternalsVisibleTo Include="GHelper.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GHelper.Core\GHelper.Core.csproj" />
    <ProjectReference Include="..\GHelper.Platform.Windows\GHelper.Platform.Windows.csproj" />
    <ProjectReference Include="..\GHelper.Platform.Linux\GHelper.Platform.Linux.csproj" />
  </ItemGroup>

</Project>
